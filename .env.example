# Copia este archivo a .env.local y completa los valores.
# Los encuentras en tu proyecto de Supabase: Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Solo servidor. Permite al API publicar configuraciones versionadas.
# Nunca uses NEXT_PUBLIC_ para esta clave.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Compatibilidad opcional con el acceso anterior de clave única.
MANTENEDOR_ACCESS_KEY=

# Login simple para el único administrador del mantenedor.
# Formato usuario:contraseña.
# Usa contraseñas fuertes antes de publicar el sitio.
MANTENEDOR_ACCOUNTS=admin:solar2026

# Necesaria para el autocompletado de direcciones y el mapa interactivo
# de la Etapa 4 (Google Maps Platform: Places API + Maps JavaScript API).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu-google-maps-api-key

# Odoo CRM — oportunidades del cotizador (solo servidor)
ODOO_URL=https://www.ggelectrics.cl
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
ODOO_CRM_TEAM=
ODOO_CRM_STAGE=
ODOO_CRM_TAG=Cotizador web

# Correo con la propuesta al cliente (opcional)
RESEND_API_KEY=
EMAIL_FROM=GG Electrics <contacto@ggelectrics.cl>

# Reintento diario de sincronización con Odoo (Vercel Cron)
CRON_SECRET=
